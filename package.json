{
  "name": "research",
  "version": "0.1.0",
  "private": true,
  "description": "Personal desktop app for thesis research: paper library, BibTeX, summaries, relations and systematic mapping",
  "author": "Eduardo V. <lalohao@gmail.com>",
  "desktopName": "research.desktop",
  "main": "./out/main/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "electron-vite build && electron-builder --linux AppImage --x64",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:summaries": "vitest run --config vitest.eval.config.mts test/eval/summaries.eval.ts",
    "eval:similarity": "vitest run --config vitest.eval.config.mts test/eval/similarity.eval.ts",
    "eval:relations": "vitest run --config vitest.eval.config.mts test/eval/relations.eval.ts",
    "test:emacs": "${EMACS:-emacs} --batch -L emacs -l emacs/research-test.el -l emacs/research-prose-test.el -f ert-run-tests-batch-and-exit",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@mozilla/readability": "0.6.0",
    "@observablehq/plot": "0.6.17",
    "cytoscape": "3.34.3",
    "cytoscape-fcose": "2.2.0",
    "i18next": "26.4.2",
    "linkedom": "0.18.13",
    "pdfjs-dist": "5.7.284",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-i18next": "17.0.16",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "turndown": "7.2.4",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/turndown": "5.0.6",
    "@vitejs/plugin-react": "4.7.0",
    "electron": "41.10.7",
    "electron-builder": "26.18.0",
    "electron-vite": "5.0.0",
    "pdf-lib": "1.17.1",
    "typescript": "6.0.3",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  },
  "build": {
    "appId": "dev.lalohao.research",
    "productName": "research",
    "executableName": "research",
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "out/**",
      "package.json",
      "!**/*.map",
      "!**/node_modules/onnxruntime-web/**",
      "!**/node_modules/onnxruntime-node/bin/napi-v6/{darwin,win32}/**",
      "!**/node_modules/onnxruntime-node/bin/napi-v6/linux/arm64/**"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources",
        "filter": [
          "icon.svg",
          "icons/**",
          "tray/**"
        ]
      }
    ],
    "asarUnpack": [
      "**/*.node",
      "**/node_modules/onnxruntime-node/bin/**",
      "**/node_modules/@img/**"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icons/icon-512.png",
      "category": "Office",
      "synopsis": "Paper library and thesis research",
      "syncDesktopName": true
    },
    "npmRebuild": false
  }
}
