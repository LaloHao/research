{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": [],
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["extension/src/**/*.ts", "extension/manifest.ts"]
}
